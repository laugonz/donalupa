{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/guides/how-to-play-murdoku/",
      "destination": "/guides/how-to-play-deduction-sudoku/",
      "permanent": true
    },
    {
      "source": "/es/guias/como-jugar-murdoku/",
      "destination": "/es/guias/como-jugar-sudoku-de-misterio/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
